{
  "name": "@deepseek-ai/dsh-client-ui-security",
  "description": "Jabberwock security project workspace",
  "version": "0.2.1-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-security"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./records": {
      "types": "./lib/types/security-records.d.ts",
      "default": "./lib/types/security-records.js"
    },
    "./conversations": {
      "types": "./lib/types/conversation-types.d.ts",
      "default": "./lib/types/conversation-types.js"
    },
    "./planning": {
      "types": "./lib/types/planning-types.d.ts",
      "default": "./lib/types/planning-types.js"
    },
    "./exploration": {
      "types": "./lib/types/exploration-types.d.ts",
      "default": "./lib/types/exploration-types.js"
    },
    "./setup": {
      "types": "./lib/types/setup-types.d.ts",
      "default": "./lib/types/setup-types.js"
    },
    "./workers": {
      "types": "./lib/types/worker-types.d.ts",
      "default": "./lib/types/worker-types.js"
    },
    "./findings": {
      "types": "./lib/types/finding-types.d.ts",
      "default": "./lib/types/finding-types.js"
    },
    "./execution": {
      "types": "./lib/types/execution-types.d.ts",
      "default": "./lib/types/execution-types.js"
    },
    "./control": {
      "types": "./lib/types/control-types.d.ts",
      "default": "./lib/types/control-types.js"
    },
    "./supply-chain": {
      "types": "./lib/types/supply-chain-types.d.ts",
      "default": "./lib/types/supply-chain-types.js"
    }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-subprocess": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-subprocess": "workspace:*",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-store": "workspace:*",
    "@deepseek-ai/dsh-client-ui-layout": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-util-crypto": "workspace:*",
    "@deepseek-ai/dsh-client-ui-workspace": "workspace:*",
    "@deepseek-ai/dsh-workspace": "workspace:*",
    "@deepseek-ai/dsh-api-remotes": "workspace:*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-token-meter": "workspace:*",
    "@deepseek-ai/dsh-client-ui-chat": "workspace:*",
    "@types/semver": "^7.8.0",
    "@deepseek-ai/dsh-app-boot": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "assets",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-subscription-engines": "workspace:*",
    "@deepseek-ai/dsh-user-questions": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*",
    "@deepseek-ai/dsh-storage-domain": "workspace:*",
    "zod": "4.4.3",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session-persistence": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@deepseek-ai/dsh-web-fetch-http": "workspace:*",
    "@deepseek-ai/dsh-http-proxy": "workspace:*",
    "ipaddr.js": "^2.5.0",
    "@deepseek-ai/dsh-skill": "workspace:*",
    "yaml": "^2.4.2",
    "playwright": "1.61.1",
    "semver": "^7.8.5",
    "@deepseek-ai/dsh-jobs": "workspace:*",
    "@deepseek-ai/dsh-session-query": "workspace:*",
    "@deepseek-ai/dsh-atomic-write": "workspace:*"
  }
}
